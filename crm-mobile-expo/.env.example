# =============================================================
# EnterpriseCRM Pro — mobile/web environment (copy to .env)
# EXPO_PUBLIC_* values are bundled INTO the app and are visible
# to anyone who has it. Never put secrets here.
# =============================================================

# Backend API base URL, including /api/v1.
#  - Physical phone:     http://<your-computer-LAN-IP>:4000/api/v1
#  - Android emulator:   http://10.0.2.2:4000/api/v1
#  - iOS simulator/web:  http://localhost:4000/api/v1
#  - Production:         https://api.your-domain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
