# =============================================================
# EnterpriseCRM Pro — backend environment (copy to .env)
# Placeholders only. Never commit a real .env.
# See docs/ENVIRONMENT.md for every variable.
# =============================================================

# development | production | test
NODE_ENV=development
PORT=4000

# Local:  mongodb://localhost:27017/crm_db
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/crm_db
MONGODB_URI=mongodb://localhost:27017/crm_db

# Two DIFFERENT random strings, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-random-hex-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-random-hex-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_EXPIRES_DAYS=30

# Browser origins allowed by CORS (comma separated). Required in
# production; "*" is only accepted outside production.
# Native mobile apps are not affected by CORS.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Number of reverse-proxy hops in front of the API (0 = none).
TRUST_PROXY=0

# Optional — Google sign-in. Leave empty to disable (/auth/google → 503).
GOOGLE_CLIENT_ID=

# Link that password-reset e-mails point to (app deep link or web page).
PASSWORD_RESET_URL=crmmobile://reset-password

# Rate limits (defaults shown)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300

# Tests only: MongoDB server used for throw-away test databases.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
